# Google is used only for the live voice conversation, speech, and transcription.
# Keep the real value only in .env/Railway secrets; never commit it.
GEMINI_API_KEY=

# Fal: Klein 9B stills, H3 Max video. Media generation only; all
# planning, reasoning, and direction use Gemini through GEMINI_API_KEY.
# Required for generated visuals; no other media fallback.
FAL_KEY=

# Fallback identity for a body that sends no X-Gizmo-Device header (the
# browser harness). The simulator and hardware identify themselves.
GIZMO_USER_ID=gizmo-local-user

# Native emulator: omit GIZMO_BRAIN_URL to run the brain locally.
# For Railway, use the HTTPS brain domain and its shared device token.
# GIZMO_BRAIN_URL=https://your-gizmo-brain.up.railway.app
# GIZMO_DEVICE_TOKEN=

# Self-hosted Memobase service root and project token from Railway.
MEMOBASE_URL=
MEMOBASE_API_KEY=

# Optional model overrides. Defaults shown.
# GIZMO_LIVE_MODEL=gemini-3.1-flash-live-preview
# GIZMO_DIRECTOR_MODEL=gemini-3.1-flash-lite
# GIZMO_REASONING_MODEL=gemini-3.7-flash

# OddityOS 1 browser preview: shared key, separate experience director.
# Cloud previews require a private adult-review code. Keep the real value in Railway.
# ODDITY_PREVIEW_TOKEN=
# ODDITY_DIRECTOR_MODEL=gemini-3.1-flash-lite
# ODDITY_TTS_MODEL=gemini-2.5-flash-preview-tts
# ODDITY_TRANSCRIBE_MODEL=gemini-3.1-flash-lite
# ODDITY_DAILY_TURN_LIMIT=120
# ODDITY_DAILY_SHOW_LIMIT=80
# ODDITY_DAILY_MOTION_LIMIT=20

# Daily still reservations across this brain. Each device is capped at 40.
# Counts persist across restarts and roll over at midnight UTC. Zero disables Show.
# GIZMO_DAILY_SHOW_LIMIT=400

# Daily motion reservations across this brain. Each device is capped at 20.
# Same UTC rollover; zero disables video generation while keeping stills.
# GIZMO_DAILY_MOTION_LIMIT=200

# Gizmo's voice: one of the Gemini Live prebuilt voices. Default: Umbriel.
# Worth an A/B: Zubenelgenubi (casual), Charon (deeper, informative).
# GIZMO_VOICE=Umbriel

# The kid's time zone, so "today" and "last time" in memory line up. Default: UTC.
# GIZMO_TZ=Asia/Tokyo

# Local transcript JSONL. Default: ./data
# GIZMO_DATA_DIR=./data
