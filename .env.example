# Required for live talk (OpenAI Realtime). If unset, Friend runs a local fake
# transport that still drives the state machine, memory, and tools.
OPENAI_API_KEY=

# Optional. Text brain + deep think via OpenRouter when the live voice is
# unavailable. Real agent (same prompt, same tools), typed replies, no audio.
OPENROUTER_API_KEY=

# Optional. Chat model for the OpenRouter text brain. Default openai/gpt-5.6-luna.
# GIZMO_TEXT_MODEL=google/gemini-3.7-flash

# Optional. MiniMax H3 Max image-to-video via fal for show() clips.
# If unset, show() still returns the print-look still and the spoken line.
FAL_KEY=

# Optional. Reasoning model for think(). Default gpt-5.6-terra.
# GIZMO_THINK_MODEL=gpt-5.6-terra

# Where sqlite + saved pages live. Survives restart. Default: ./data
# GIZMO_DATA_DIR=./data
